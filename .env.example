# ==============================================================================
# Environment Variables Example (.env.example)
# Personal Trainer Platform
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Local: postgresql://postgres@localhost:5432/personal_trainer_dev
# Prod (Neon): postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://postgres@localhost:5432/personal_trainer_dev"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# Local: http://localhost:3000 | Prod: https://<tu-app>.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-32-bytes-base64-secret"
AUTH_TRUST_HOST="true"

# NextAuth v4/v5 fallbacks
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-bytes-base64-secret"

# ------------------------------------------------------------------------------
# 3. Initial Seed / SuperAdmin Setup
# ------------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL="admin@plataforma.com"
SEED_SUPERADMIN_PASSWORD="AdminPlatform2026!"
SEED_SUPERADMIN_NAME="SuperAdmin Plataforma"
