// Personal Trainer Platform — Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Objetivo {
  hipertrofia
  fuerza
  descenso
}

enum Nivel {
  principiante
  intermedio
  avanzado
}

enum Modalidad {
  gimnasio
  casa
}

enum RoutineStatus {
  active
  historic
}

// ─────────────────────────────────────────────
// TRAINER (Admin — single user for MVP)
// ─────────────────────────────────────────────

model Trainer {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("trainers")
}

// ─────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────

model Student {
  id                 String    @id @default(uuid())
  dni                String    @unique                   // public identifier — RN-03
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String?
  phone              String?
  objetivo           Objetivo?
  nivel              Nivel?
  modalidad          Modalidad?
  membershipStartsAt DateTime? @map("membership_starts_at") @db.Date
  paymentExpiresAt   DateTime? @map("payment_expires_at") @db.Date
  healthNotes        String?   @map("health_notes")
  isActive           Boolean   @default(true) @map("is_active") // soft delete
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  assignedRoutines AssignedRoutine[]
  progressLogs     ProgressLog[]

  @@index([dni], name: "idx_students_dni")
  @@map("students")
}

// ─────────────────────────────────────────────
// EXERCISE LIBRARY
// ─────────────────────────────────────────────

model Exercise {
  id              String   @id @default(uuid())
  name            String   @unique
  primaryMuscle   String   @map("primary_muscle")
  secondaryMuscle String?  @map("secondary_muscle")
  videoUrl        String?  @map("video_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  exerciseBlocks ExerciseBlock[]

  @@map("exercises")
}

// ─────────────────────────────────────────────
// ROUTINE TEMPLATES
// ─────────────────────────────────────────────

model RoutineTemplate {
  id            String   @id @default(uuid())
  name          String
  description   String?
  durationWeeks Int      @default(4) @map("duration_weeks")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  trainingDays     TrainingDay[]
  assignedRoutines AssignedRoutine[]

  @@map("routine_templates")
}

model TrainingDay {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  label      String                       // e.g. "Día 1 – Tren Superior"
  dayOrder   Int    @map("day_order")

  template       RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseBlocks ExerciseBlock[]

  @@map("training_days")
}

model ExerciseBlock {
  id             String  @id @default(uuid())
  trainingDayId  String  @map("training_day_id")
  exerciseId     String  @map("exercise_id")
  sets           Int
  reps           Int?                      // null if duration-based
  durationSecs   Int?    @map("duration_secs") // null if rep-based
  restSecs       Int?    @map("rest_secs")
  trainerNotes   String? @map("trainer_notes")
  blockOrder     Int     @map("block_order")

  trainingDay     TrainingDay      @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id])
  routineOverrides RoutineOverride[]
  progressLogs    ProgressLog[]

  @@map("exercise_blocks")
}

// ─────────────────────────────────────────────
// ASSIGNED ROUTINES
// ─────────────────────────────────────────────

model AssignedRoutine {
  id         String        @id @default(uuid())
  studentId  String        @map("student_id")
  templateId String        @map("template_id")            // origin template (reference, not copy)
  status     RoutineStatus @default(active)
  assignedAt DateTime      @default(now()) @map("assigned_at")
  expiresAt  DateTime?     @map("expires_at")             // calculated from duration_weeks

  student  Student         @relation(fields: [studentId], references: [id])
  template RoutineTemplate @relation(fields: [templateId], references: [id])

  overrides    RoutineOverride[]
  progressLogs ProgressLog[]

  // RN-04: only one ACTIVE routine per student, enforced at DB level via a
  // partial unique index (see migration SQL — Prisma's schema DSL can't
  // express a WHERE clause on @@unique, so it isn't declared here).
  @@index([studentId, status], name: "idx_assigned_routines_student_status")
  @@map("assigned_routines")
}

// ─────────────────────────────────────────────
// ROUTINE OVERRIDES (individual customizations — RN-02)
// ─────────────────────────────────────────────

model RoutineOverride {
  id                String  @id @default(uuid())
  assignedRoutineId String  @map("assigned_routine_id")
  exerciseBlockId   String  @map("exercise_block_id")
  sets              Int?                       // null = use template value
  reps              Int?
  durationSecs      Int?    @map("duration_secs")
  restSecs          Int?    @map("rest_secs")
  trainerNotes      String? @map("trainer_notes")

  assignedRoutine AssignedRoutine @relation(fields: [assignedRoutineId], references: [id], onDelete: Cascade)
  exerciseBlock   ExerciseBlock   @relation(fields: [exerciseBlockId], references: [id])

  @@map("routine_overrides")
}

// ─────────────────────────────────────────────
// PROGRESS LOGS
// ─────────────────────────────────────────────

model ProgressLog {
  id                String   @id @default(uuid())
  studentId         String   @map("student_id")
  assignedRoutineId String   @map("assigned_routine_id")
  exerciseBlockId   String   @map("exercise_block_id")
  loggedDate        DateTime @map("logged_date") @db.Date
  weightKg          Decimal? @map("weight_kg") @db.Decimal(6, 2)
  completed         Boolean  @default(false)
  studentNotes      String?  @map("student_notes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  student         Student         @relation(fields: [studentId], references: [id])
  assignedRoutine AssignedRoutine @relation(fields: [assignedRoutineId], references: [id])
  exerciseBlock   ExerciseBlock   @relation(fields: [exerciseBlockId], references: [id])

  // One log per exercise per day per student
  @@unique([studentId, exerciseBlockId, loggedDate], name: "unique_progress_per_day")
  @@index([studentId, loggedDate], name: "idx_progress_student_date")
  @@map("progress_logs")
}
