// Personal Trainer Platform — Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Nivel {
  principiante
  intermedio
  avanzado
}

enum RoutineStatus {
  active
  historic
}

enum GenericLevel {
  basico
  intermedio
  avanzado
}

// HU-35: clasificación liviana de la nota del alumno — no reemplaza el texto
// libre, solo permite filtrar rápido sin releer todo el historial.
enum NoteType {
  session
  incident
  discomfort
}

enum AccessOverride {
  auto
  allowed
  blocked
}

enum Role {
  SUPERADMIN
  COACH
}

// ─────────────────────────────────────────────
// TRAINER (Tenant Admin & Platform SuperAdmin)
// ─────────────────────────────────────────────

model Trainer {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           Role     @default(COACH)
  slug           String   @unique
  businessName   String?  @map("business_name")
  headline       String?
  tagline        String?
  logoUrl        String?  @map("logo_url")
  heroImageUrl   String?  @map("hero_image_url")
  whatsappNumber      String?   @map("whatsapp_number")
  instagramUrl        String?   @map("instagram_url")
  maxPlans            Int       @default(1) @map("max_plans")
  maxStudents         Int       @default(10) @map("max_students")
  maxGenericProfiles  Int       @default(3) @map("max_generic_profiles")
  membershipExpiresAt DateTime? @map("membership_expires_at") @db.Date
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  students         Student[]
  plans            Plan[]
  routineTemplates RoutineTemplate[]
  genericProfiles  GenericProfile[]
  exercises        Exercise[]

  @@map("trainers")
}

// ─────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────

model Student {
  id                 String          @id @default(uuid())
  trainerId          String          @map("trainer_id")
  dni                String                            // public identifier per coach — RN-03
  firstName          String          @map("first_name")
  lastName           String          @map("last_name")
  email              String?
  phone              String?
  objetivoId         String?         @map("objetivo_id") // objetivo principal — lista cerrada y administrable, no texto libre
  secondaryGoals     String?         @map("secondary_goals") // texto libre: objetivos secundarios/prioridades (HU-34)
  nivel              Nivel?
  modalidadId        String?         @map("modalidad_id")
  membershipStartsAt DateTime?       @map("membership_starts_at") @db.Date
  paymentExpiresAt   DateTime?       @map("payment_expires_at") @db.Date
  accessOverride     AccessOverride  @default(auto) @map("access_override")
  height             Int?
  age                Int?
  healthNotes        String?         @map("health_notes")
  isActive           Boolean         @default(true) @map("is_active") // soft delete
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Sin onDelete override — RESTRICT por defecto, igual que Exercise: no se
  // puede borrar un objetivo/modalidad mientras algún alumno lo tenga
  // asignado (bloqueo explícito en el service, ver ObjetivoInUseError).
  trainer          Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  objetivoRef      Objetivo?         @relation(fields: [objetivoId], references: [id])
  modalidadRef     Modalidad?        @relation(fields: [modalidadId], references: [id])
  assignedRoutines AssignedRoutine[]
  progressLogs     ProgressLog[]
  bodyWeightLogs   BodyWeightLog[]
  subscriptions    StudentSubscription[]
  payments         Payment[]

  @@unique([trainerId, dni], name: "unique_student_per_trainer")
  @@index([trainerId, dni], name: "idx_students_trainer_dni")
  @@map("students")
}

// ─────────────────────────────────────────────
// STUDENT TAXONOMIES (admin-manageable lists — not hardcoded enums)
// ─────────────────────────────────────────────

model Objetivo {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  students Student[]

  @@map("objetivos")
}

model Modalidad {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  students Student[]

  @@map("modalidades")
}

// ─────────────────────────────────────────────
// EXERCISE LIBRARY
// ─────────────────────────────────────────────

model Exercise {
  id              String   @id @default(uuid())
  trainerId       String?  @map("trainer_id")
  name            String
  primaryMuscle   String   @map("primary_muscle")
  secondaryMuscle String?  @map("secondary_muscle")
  videoUrl        String?  @map("video_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  trainer        Trainer?        @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  exerciseBlocks ExerciseBlock[]

  @@index([trainerId], name: "idx_exercises_trainer")
  @@map("exercises")
}

// ─────────────────────────────────────────────
// ROUTINE TEMPLATES
// ─────────────────────────────────────────────

model RoutineTemplate {
  id            String   @id @default(uuid())
  trainerId     String   @map("trainer_id")
  name          String
  description   String?
  durationWeeks Int      @default(4) @map("duration_weeks")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  trainer          Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  trainingDays     TrainingDay[]
  assignedRoutines AssignedRoutine[]
  genericProfiles  GenericProfile[]

  @@index([trainerId], name: "idx_routine_templates_trainer")
  @@map("routine_templates")
}

model TrainingDay {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  label      String                       // e.g. "Día 1 – Tren Superior"
  dayOrder   Int    @map("day_order")

  template       RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseBlocks ExerciseBlock[]

  @@map("training_days")
}

model ExerciseBlock {
  id             String  @id @default(uuid())
  trainingDayId  String  @map("training_day_id")
  exerciseId     String  @map("exercise_id")
  sets           Int
  reps           Int?                      // null if duration-based or using repsScheme
  repsScheme     String? @map("reps_scheme")  // free text for variable schemes, e.g. "1x6 2x5 1x4"
  weightKg       Decimal? @map("weight_kg") @db.Decimal(6, 2) // prescribed weight
  intensity      String? // free text, e.g. "@7" (RPE-style notation) — not a strict enum
  tempo          String? // free text, e.g. "3-1-1-0" or "controlado" — not obligatory, not a metric
  durationSecs   Int?    @map("duration_secs") // null if rep-based
  restSecs       Int?    @map("rest_secs")
  trainerNotes   String? @map("trainer_notes")
  blockOrder     Int     @map("block_order")
  // HU-33: agrupa ejercicios consecutivos del mismo día bajo una etiqueta
  // (ej. "A") para formar una superserie/circuito. No es un id relacional —
  // el agrupamiento es por etiqueta + orden consecutivo (mismo criterio que
  // el resto del schema, sin modelar un calendario/estructura extra).
  groupLabel     String? @map("group_label")
  // Descanso a nivel de bloque/grupo (después de completar todos los
  // ejercicios del grupo), distinto de `restSecs` que es por ejercicio.
  groupRestSecs  Int?    @map("group_rest_secs")

  trainingDay     TrainingDay      @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id])
  routineOverrides RoutineOverride[]
  progressLogs    ProgressLog[]

  @@map("exercise_blocks")
}

// ─────────────────────────────────────────────
// ASSIGNED ROUTINES
// ─────────────────────────────────────────────

model AssignedRoutine {
  id         String        @id @default(uuid())
  studentId  String        @map("student_id")
  templateId String        @map("template_id")            // origin template (reference, not copy)
  status     RoutineStatus @default(active)
  assignedAt DateTime      @default(now()) @map("assigned_at")
  expiresAt  DateTime?     @map("expires_at")             // calculated from duration_weeks

  student  Student         @relation(fields: [studentId], references: [id])
  template RoutineTemplate @relation(fields: [templateId], references: [id])

  overrides    RoutineOverride[]
  progressLogs ProgressLog[]

  // RN-04: only one ACTIVE routine per student, enforced at DB level via a
  // partial unique index (see migration SQL — Prisma's schema DSL can't
  // express a WHERE clause on @@unique, so it isn't declared here).
  @@index([studentId, status], name: "idx_assigned_routines_student_status")
  @@map("assigned_routines")
}

// ─────────────────────────────────────────────
// ROUTINE OVERRIDES (individual customizations — RN-02)
// ─────────────────────────────────────────────

model RoutineOverride {
  id                String  @id @default(uuid())
  assignedRoutineId String  @map("assigned_routine_id")
  exerciseBlockId   String  @map("exercise_block_id")
  sets              Int?                       // null = use template value
  reps              Int?
  repsScheme        String? @map("reps_scheme")
  weightKg          Decimal? @map("weight_kg") @db.Decimal(6, 2)
  intensity         String?
  tempo             String?
  durationSecs      Int?    @map("duration_secs")
  restSecs          Int?    @map("rest_secs")
  trainerNotes      String? @map("trainer_notes")

  assignedRoutine AssignedRoutine @relation(fields: [assignedRoutineId], references: [id], onDelete: Cascade)
  exerciseBlock   ExerciseBlock   @relation(fields: [exerciseBlockId], references: [id])

  @@map("routine_overrides")
}

// ─────────────────────────────────────────────
// GENERIC PROFILES (shared, non-Student access by level — no tracking)
// ─────────────────────────────────────────────

model GenericProfile {
  id                 String           @id @default(uuid())
  trainerId          String           @map("trainer_id")
  name               String
  level              GenericLevel?
  passwordHash       String           @map("password_hash")
  assignedTemplateId String?          @map("assigned_template_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  trainer          Trainer          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assignedTemplate RoutineTemplate? @relation(fields: [assignedTemplateId], references: [id], onDelete: SetNull)

  @@unique([trainerId, name], name: "unique_generic_profile_name_per_trainer")
  @@index([trainerId], name: "idx_generic_profiles_trainer")
  @@map("generic_profiles")
}

// ─────────────────────────────────────────────
// PROGRESS LOGS
// ─────────────────────────────────────────────

model ProgressLog {
  id                String   @id @default(uuid())
  studentId         String   @map("student_id")
  assignedRoutineId String   @map("assigned_routine_id")
  exerciseBlockId   String   @map("exercise_block_id")
  loggedDate        DateTime @map("logged_date") @db.Date
  weightKg          Decimal? @map("weight_kg") @db.Decimal(6, 2)
  completed         Boolean  @default(false)
  studentNotes      String?  @map("student_notes")
  noteType          NoteType? @map("note_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  student         Student         @relation(fields: [studentId], references: [id])
  assignedRoutine AssignedRoutine @relation(fields: [assignedRoutineId], references: [id])
  exerciseBlock   ExerciseBlock   @relation(fields: [exerciseBlockId], references: [id])

  // One log per exercise per day per student
  @@unique([studentId, exerciseBlockId, loggedDate], name: "unique_progress_per_day")
  @@index([studentId, loggedDate], name: "idx_progress_student_date")
  @@map("progress_logs")
}

// ─────────────────────────────────────────────
// BODY WEIGHT LOGS (HU-32 — independiente de progress_logs,
// que es peso LEVANTADO por ejercicio, no peso corporal)
// ─────────────────────────────────────────────

model BodyWeightLog {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  loggedDate DateTime @map("logged_date") @db.Date
  weightKg   Decimal  @map("weight_kg") @db.Decimal(6, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  // Un registro de peso corporal por día por alumno
  @@unique([studentId, loggedDate], name: "unique_body_weight_per_day")
  @@index([studentId, loggedDate], name: "idx_body_weight_student_date")
  @@map("body_weight_logs")
}

// ─────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid())
  trainerId    String   @map("trainer_id")
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int      @default(30) @map("duration_days")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  trainer       Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subscriptions StudentSubscription[]

  @@unique([trainerId, name], name: "unique_plan_per_trainer")
  @@index([trainerId], name: "idx_plans_trainer")
  @@map("plans")
}

model StudentSubscription {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  planId        String   @map("plan_id")
  priceSnapshot Decimal  @map("price_snapshot") @db.Decimal(10, 2)
  startDate     DateTime @map("start_date") @db.Date
  expiresAt     DateTime @map("expires_at") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  student  Student   @relation(fields: [studentId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([studentId], name: "idx_student_subscriptions_student")
  @@map("student_subscriptions")
}

// ─────────────────────────────────────────────
// PAYMENTS & LEDGER
// ─────────────────────────────────────────────

model Payment {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  subscriptionId String?  @map("subscription_id")
  amount         Decimal  @db.Decimal(10, 2)
  paidAt         DateTime @map("paid_at") @db.Date
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  student      Student              @relation(fields: [studentId], references: [id])
  subscription StudentSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([studentId], name: "idx_payments_student")
  @@map("payments")
}

